{
  "name": "uiflow",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "pnpm --filter @uiflow/graph-ui build && node scripts/build-extension.mjs",
    "test": "vitest run",
    "package": "pnpm build && node scripts/package-extension.mjs"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.25.5",
    "typescript": "5.8.3",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.5",
      "@vscode/vsce>minimatch": "11.0.1"
    }
  }
}
